        self.entrada_apuesta.place(x=150, y=850)

        self.entrada_apuesta.insert(0, "1")

        texto_vueltas = tk.Label( self.ventana,text="Número de vueltas:",font=("Arial", 12),bg="white")
        texto_vueltas.place(x=250, y=850)

