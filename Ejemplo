        self.entrada_vueltas.place(x=390, y=850)

        self.entrada_vueltas.insert(0, "1")

        texto_velocidad = tk.Label(self.ventana,text="Velocidad:",font=("Arial", 12),bg="white")
        texto_velocidad.place(x=480, y=850)

        self.slider = tk.Scale(self.ventana,from_=1,to=10,orient="horizontal",length=150)
        self.slider.set(5)
        self.slider.place(x=560, y=825)

        self.boton_iniciar = tk.Button(self.ventana,text="Start",font=("Arial", 15),command=self.iniciar_carrera)
        self.boton_iniciar.place(x=750,y=820,width=100,height=40)

        self.boton_reiniciar = tk.Button(self.ventana,text="Reiniciar",font=("Arial", 15),command=self.reiniciar_carrera)
        self.boton_reiniciar.place(x=860,y=820,width=110,height=40)

        self.mensaje = tk.Label(self.ventana,text="",font=("Arial", 12),bg="white")
        self.mensaje.place(x=300, y=900)

        self.resultados = tk.Label(self.ventana,text="",font=("Arial", 12),justify="left",bg="white")
        self.resultados.place(x=350, y=940)

        self.crear_pista()

