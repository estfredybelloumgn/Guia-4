        self.vehiculos = [self.vehiculo1,self.vehiculo2,self.vehiculo3,self.vehiculo4,self.vehiculo5,self.vehiculo6,self.vehiculo7,self.vehiculo8,self.vehiculo9,self.vehiculo10]

    def iniciar_carrera(self):
        if self.carrera_iniciada:
            return
        try:
            self.vehiculo_apostado = int(self.entrada_apuesta.get())
            self.numero_vueltas = int(self.entrada_vueltas.get())

            if self.vehiculo_apostado < 1:
                self.mensaje.config(text="El vehículo debe estar entre 1 y 10")
                return

            if self.vehiculo_apostado > 10:
                self.mensaje.config(text="El vehículo debe estar entre 1 y 10")
                return

            if self.numero_vueltas <= 0:
                self.mensaje.config(text="Las vueltas deben ser mayores que cero")
                return

        except:

            self.mensaje.config(text="Ingrese números válidos")
            return

        self.carrera_iniciada = True
        self.carrera_terminada = False

        self.tiempos = [None] * 10
        self.temporizadores = [None] * 10
        self.vueltas = [0] * 10

        self.tiempo_inicio = time.time()

        self.mensaje.config(text="La carrera ha comenzado")

        self.resultados.config(text="")

        for i in range(10):
            self.iniciar_temporizador(i)

    def iniciar_temporizador(self, numero):

        velocidad = self.slider.get()

        tiempo_minimo = 30
        tiempo_maximo = 150

        tiempo = random.randint(tiempo_minimo,tiempo_maximo)

        tiempo = tiempo - (velocidad * 5)

        if tiempo < 10:
            tiempo = 10

        self.temporizadores[numero] = threading.Timer(tiempo / 1000,self.mover_vehiculo,args=(numero,))

        self.temporizadores[numero].start()

    def mover_vehiculo(self, numero):

        if self.carrera_terminada:
            return

        vehiculo = self.vehiculos[numero]
        posicion_actual = vehiculo.winfo_x()
        nuevo_x = posicion_actual + 5

        if nuevo_x >= 900:
            nuevo_x = 0

            self.vueltas[numero] = (self.vueltas[numero] + 1)

        vehiculo.place(x=nuevo_x)

        if self.vueltas[numero] >= self.numero_vueltas:
            self.finalizar_vehiculo(numero)
        else:
            self.iniciar_temporizador(numero)

    def finalizar_vehiculo(self, numero):
        if self.tiempos[numero] is None:
            self.tiempos[numero] = (time.time() - self.tiempo_inicio)

        cantidad_terminados = 0

        for tiempo in self.tiempos:

            if tiempo is not None:
                cantidad_terminados + 1
                )

        if cantidad_terminados == 10:

            self.finalizar_carrera()

    def finalizar_carrera(self):

        self.carrera_terminada = True
        self.carrera_iniciada = False

        for temporizador in self.temporizadores:

            if temporizador is not None:
                temporizador.cancel()

        resultados = []

        for i in range(10):

            resultados.append(
                (
                    self.tiempos[i],
                    i + 1
                )
            )

        resultados.sort()

        texto = "RESULTADOS FINALES

"

        posicion = 1

        for tiempo, vehiculo in resultados:

            texto = texto + (
                str(posicion)
                + ". Vehículo "
                + str(vehiculo)
                + " - "
                + str(round(tiempo, 2))
                + " segundos
"
            )

            posicion = posicion + 1

        ganador = resultados[0][1]

        if ganador == self.vehiculo_apostado:

            texto = texto + "
¡Ganaste la apuesta!"

        else:

            texto = texto + (
                "
No ganaste. El ganador fue el vehículo "
                + str(ganador)
            )

        self.resultados.config(
            text=texto
        )

        self.mensaje.config(
            text="La carrera terminó"
        )

    def reiniciar_carrera(self):

        for temporizador in self.temporizadores:

            if temporizador is not None:
                temporizador.cancel()

        self.carrera_iniciada = False
        self.carrera_terminada = False

        self.tiempos = [None] * 10
        self.temporizadores = [None] * 10
        self.vueltas = [0] * 10

        posiciones_y = [
            0,
            80,
            160,
            240,
            320,
            400,
            480,
            560,
            640,
            720
        ]

        for i in range(10):

            self.vehiculos[i].place(
                x=0,
                y=posiciones_y[i]
            )

        self.mensaje.config(
            text=""
        )

        self.resultados.config(
            text=""
        )


ventana = tk.Tk()

objeto = Carrera(ventana)

ventana.mainloop()
